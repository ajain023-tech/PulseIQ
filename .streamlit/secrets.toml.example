# Streamlit Community Cloud -> App settings -> Secrets. Root-level keys become env vars.
# Never commit a real .streamlit/secrets.toml (it is git-ignored).
PULSEIQ_SIZE = "small"
PULSEIQ_LLM_PROVIDER = "gemini"     # gemini | anthropic | openai  (omit for offline mode)
GEMINI_API_KEY = "paste-your-key-here"
# ANTHROPIC_API_KEY = "..."
# OPENAI_API_KEY = "..."
